---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';
import { cv } from '../../data/cv';
import { t, langPath } from '../../utils/i18n';
import type { Lang } from '../../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const data = cv[lang];
const currentPath = langPath(lang, '/cv');

// Group experience by employer (organization + location) so same employer appears once
const experienceByEmployer = data.experience.reduce(
  (acc, item) => {
    const key = `${item.organization}|${item.location}`;
    if (!acc[key]) {
      acc[key] = { organization: item.organization, location: item.location, roles: [] };
    }
    acc[key].roles.push({
      title: item.title,
      date: item.date,
      description: item.description,
    });
    return acc;
  },
  {} as Record<string, { organization: string; location: string; roles: { title: string; date: string; description: string }[] }>
);
const experienceGroups = Object.values(experienceByEmployer);

// Group education by institution (same pattern as experience — pill + dotted roles)
const educationByInstitution = data.education.reduce(
  (acc, item) => {
    const key = `${item.institution}|${item.location}`;
    if (!acc[key]) {
      acc[key] = { institution: item.institution, location: item.location, entries: [] };
    }
    acc[key].entries.push({
      degree: item.degree,
      date: item.date,
      description: item.description,
      thesis: item.thesis,
      finalMark: item.finalMark,
      href: item.href,
    });
    return acc;
  },
  {} as Record<string, { institution: string; location: string; entries: { degree: string; date: string; description?: string; thesis?: string; finalMark?: string; href?: string }[] }>
);
const educationGroups = Object.values(educationByInstitution);

// Group awards by year
const awardsByYear = (data.awards ?? []).reduce(
  (acc, award) => {
    const y = award.year;
    if (!acc[y]) acc[y] = [];
    acc[y].push({ title: award.title, detail: award.detail, description: award.description, href: award.href });
    return acc;
  },
  {} as Record<string, { title: string; detail: string; description?: string; href?: string }[]>
);
const awardYears = Object.keys(awardsByYear).sort((a, b) => Number(b) - Number(a));

// ── Contact obfuscation (Tier 1) ─────────────────────────
// Contact details are base64-encoded at build time so no readable
// address ends up in the static HTML. They are decoded client-side
// only after the visitor reveals them (or when printing the CV).
const B64_ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
function toBase64(input: string): string {
  const bytes: number[] = [];
  for (let i = 0; i < input.length; i++) {
    const code = input.charCodeAt(i);
    if (code < 0x80) {
      bytes.push(code);
    } else if (code < 0x800) {
      bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    } else {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    }
  }
  let out = '';
  for (let i = 0; i < bytes.length; i += 3) {
    const b0 = bytes[i];
    const b1 = i + 1 < bytes.length ? bytes[i + 1] : 0;
    const b2 = i + 2 < bytes.length ? bytes[i + 2] : 0;
    out += B64_ALPHABET[b0 >> 2];
    out += B64_ALPHABET[((b0 & 3) << 4) | (b1 >> 4)];
    out += i + 1 < bytes.length ? B64_ALPHABET[((b1 & 15) << 2) | (b2 >> 6)] : '=';
    out += i + 2 < bytes.length ? B64_ALPHABET[b2 & 63] : '=';
  }
  return out;
}

const contactPayload = {
  contact: data.contact.map((c) => ({
    label: toBase64(c.label),
    value: toBase64(c.value),
    href: c.href ? toBase64(c.href) : '',
  })),
  header: {
    email: siteConfig.social.email ? toBase64(siteConfig.social.email) : '',
    scholar: siteConfig.social.scholar ? toBase64(siteConfig.social.scholar) : '',
    github: siteConfig.social.github ? toBase64(siteConfig.social.github) : '',
  },
};
const contactJson = JSON.stringify(contactPayload);

const revealLabel = lang === 'en' ? 'Reveal contact details' : 'Mostra i contatti';
const noscriptText =
  lang === 'en'
    ? 'Please enable JavaScript to view the contact details.'
    : 'Abilita JavaScript per visualizzare i contatti.';
---

<BaseLayout
  title={`${t(lang, 'cv.title')} — ${siteConfig.name}`}
  description={data.profile}
  lang={lang}
  currentPath={currentPath}
>
  <div class="cv-print-header">
    <h1 class="cv-print-name">{siteConfig.name}</h1>
    <p class="cv-print-role">{siteConfig.role[lang]}</p>
    <p class="cv-print-contact" id="print-contact"></p>
  </div>

  <div class="cv-title-row">
    <h1 class="page-title cv-screen-title">{t(lang, 'cv.title')}</h1>
    <div class="cv-actions no-print">
      <button id="print-cv" class="btn" type="button">
        {lang === 'en' ? 'Print / Save PDF' : 'Stampa / Salva PDF'}
      </button>
    </div>
  </div>

  <section class="cv-section">
    <h2 class="section-title">{t(lang, 'cv.profile')}</h2>
    <p>{data.profile}</p>
  </section>

  <section class="cv-section">
    <h2 class="section-title">{t(lang, 'cv.experience')}</h2>
    {experienceGroups.map((group) => (
      <div class="cv-employer-group">
        <div class="cv-employer-header">{group.organization} &middot; {group.location}</div>
        {group.roles.map((role) => (
          <div class="cv-role">
            <div class="cv-role-head">
              <span class="cv-role-title">{role.title}</span>
              <span class="cv-role-date">{role.date}</span>
            </div>
            <p class="cv-role-desc">{role.description}</p>
          </div>
        ))}
      </div>
    ))}
  </section>

  <section class="cv-section">
    <h2 class="section-title">{t(lang, 'cv.education')}</h2>
    {educationGroups.map((group) => (
      <div class="cv-employer-group">
        <div class="cv-employer-header">{group.institution} &middot; {group.location}</div>
        {group.entries.map((entry) => (
          <div class="cv-role">
            <div class="cv-role-head">
              <span class="cv-role-title">
                {entry.degree}
                {entry.href && (
                  <a class="cv-role-link-icon" href={entry.href} target="_blank" rel="noopener noreferrer" aria-label="Open link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15 3 21 3 21 9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </a>
                )}
              </span>
              <span class="cv-role-date">{entry.date}</span>
            </div>
            {entry.description && <p class="cv-role-desc">{entry.description}</p>}
            {entry.thesis && (
              <p class="cv-role-desc">
                {lang === 'en' ? 'Thesis title: ' : 'Titolo tesi: '}
                <em>{entry.thesis}</em>
              </p>
            )}
            {entry.finalMark && (
              <p class="cv-role-desc">
                {lang === 'en' ? 'Final mark: ' : 'Voto: '}
                {entry.finalMark}
              </p>
            )}
          </div>
        ))}
      </div>
    ))}
  </section>

  {data.awards && data.awards.length > 0 && (
    <section class="cv-section">
      <h2 class="section-title">{t(lang, 'cv.awards')}</h2>
      {awardYears.map((year) => (
        <div class="cv-employer-group">
          <div class="cv-employer-header">{year}</div>
          {awardsByYear[year].map((award) => (
            <div class="cv-role">
              <div class="cv-role-head">
                <span class="cv-role-title">
                  {award.title}
                  {award.href && (
                    <a class="cv-role-link-icon" href={award.href} target="_blank" rel="noopener noreferrer" aria-label="Open link">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                  )}
                </span>
              </div>
              <p class="cv-role-desc">{award.detail}</p>
              {award.description && (
                <div class="cv-award-citation">
                  <p class="cv-award-citation-text">{award.description}</p>
                </div>
              )}
            </div>
          ))}
        </div>
      ))}
    </section>
  )}

  <section class="cv-section cv-contact-section">
    <h2 class="section-title">{t(lang, 'cv.contact')}</h2>
    <div id="contact-gate" class="contact-gate no-print">
      <button id="reveal-contact" class="btn" type="button">{revealLabel}</button>
      <noscript><p class="contact-gate-text">{noscriptText}</p></noscript>
    </div>
    <ul class="contact-list" id="contact-list" hidden></ul>
    <script type="application/json" id="contact-data" set:html={contactJson}></script>
  </section>
</BaseLayout>

<style>
  .cv-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .cv-title-row .page-title {
    margin: 0;
    padding-bottom: 0;
    border-bottom: none;
    flex: 1;
    min-width: 0;
  }

  .cv-actions {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .cv-title-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .cv-title-row .page-title {
      flex: none;
    }
  }

  .cv-print-header {
    display: none;
  }

  .contact-gate {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  /* Author display rules override the default [hidden] behaviour, so hide explicitly. */
  .contact-gate[hidden] {
    display: none;
  }

  .contact-gate-text {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>

<script>
  function fromBase64(b64: string): string {
    if (!b64) return '';
    try {
      return decodeURIComponent(
        Array.prototype.map
          .call(atob(b64), (c: string) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
          .join('')
      );
    } catch {
      return '';
    }
  }

  // Decodes the obfuscated contact details and renders them in place.
  // Idempotent: safe to call multiple times (reveal click, print, etc.).
  function revealContacts() {
    const dataEl = document.getElementById('contact-data');
    if (!dataEl || !dataEl.textContent) return;

    let payload: {
      contact?: { label: string; value: string; href: string }[];
      header?: { email?: string; scholar?: string; github?: string };
    } = {};
    try {
      payload = JSON.parse(dataEl.textContent);
    } catch {
      return;
    }

    const list = document.getElementById('contact-list') as HTMLUListElement | null;
    const gate = document.getElementById('contact-gate');
    if (list && list.hidden) {
      list.innerHTML = '';
      (payload.contact ?? []).forEach((entry) => {
        const li = document.createElement('li');
        li.className = 'cv-contact-item';

        const label = document.createElement('span');
        label.className = 'cv-contact-label';
        label.textContent = fromBase64(entry.label);
        li.appendChild(label);

        const value = fromBase64(entry.value);
        const href = fromBase64(entry.href);
        if (href) {
          const a = document.createElement('a');
          a.href = href;
          a.textContent = value;
          if (!href.startsWith('mailto:')) {
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
          }
          li.appendChild(a);
        } else {
          const span = document.createElement('span');
          span.textContent = value;
          li.appendChild(span);
        }
        list.appendChild(li);
      });
      list.hidden = false;
      if (gate) gate.hidden = true;
    }

    // Fill the print-only header so the exported PDF stays complete.
    const printEl = document.getElementById('print-contact');
    if (printEl && !printEl.textContent) {
      const header = payload.header ?? {};
      const parts: string[] = [];
      if (header.email) parts.push(fromBase64(header.email));
      if (header.scholar) parts.push('Scholar: ' + fromBase64(header.scholar));
      if (header.github) parts.push('GitHub: ' + fromBase64(header.github));
      printEl.textContent = parts.join('  |  ');
    }
  }

  function initCvPage() {
    document.getElementById('reveal-contact')?.addEventListener('click', revealContacts);
    document.getElementById('print-cv')?.addEventListener('click', () => {
      revealContacts();
      window.print();
    });
  }

  // Ensure the PDF is complete even when printed via Cmd/Ctrl+P.
  window.addEventListener('beforeprint', revealContacts);

  initCvPage();
  document.addEventListener('astro:after-swap', initCvPage);
</script>
